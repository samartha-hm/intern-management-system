{
  "name": "intern-management-backend",
  "version": "1.0.0",
  "description": "Backend for Experimind Labs Intern Management System",
  "private": true,
  "main": "src/server.ts",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-async-errors": "^3.1.0",
    "express-async-handler": "^1.2.0",
    "helmet": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "joi": "^17.0.0",

    "multer": "^1.4.0",
    "winston": "^3.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/bcryptjs": "^2.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/cookie-parser": "^1.0.0",
    "@types/cors": "^2.8.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^18.0.0",
    "@types/jest": "^29.0.0",
    "typescript": "^4.9.0",
    "ts-node-dev": "^2.0.0",
    "nodemon": "^2.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-import": "^2.0.0",
    "prisma": "^5.0.0",
    "prettier": "^2.0.0",
    "@types/morgan": "^1.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}